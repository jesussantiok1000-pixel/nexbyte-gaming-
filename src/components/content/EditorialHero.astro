---
interface Props {
  image: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { image, eyebrow, title, description } = Astro.props;
---
<header class="editorial-hero">
  <picture>
    <source srcset={`/images/${image}.avif`} type="image/avif" />
    <source srcset={`/images/${image}.webp`} type="image/webp" />
    <img src={`/images/${image}.png`} alt="" width="2048" height="768" loading="eager" fetchpriority="high" />
  </picture>
  <div class="editorial-hero__shade"></div>
  <div class="editorial-hero__copy">
    <p class="editorial-hero__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</header>

<style>
  .editorial-hero{position:relative;isolation:isolate;aspect-ratio:8/3;min-height:320px;max-height:410px;margin-bottom:28px;overflow:hidden;border:1px solid rgb(255 255 255 / .12);border-radius:20px;background:#07152f;color:#fff;box-shadow:0 18px 42px rgb(7 21 47 / .16)}
  .editorial-hero picture,.editorial-hero picture img,.editorial-hero__shade{position:absolute;inset:0;width:100%;height:100%}
  .editorial-hero picture img{object-fit:cover;object-position:center;image-rendering:auto}
  .editorial-hero__shade{background:linear-gradient(90deg,rgb(7 21 47 / .9) 0%,rgb(7 21 47 / .68) 34%,rgb(7 21 47 / .15) 58%,transparent 76%)}
  .editorial-hero__copy{position:relative;z-index:1;display:flex;height:100%;max-width:650px;flex-direction:column;justify-content:center;padding:clamp(30px,5vw,62px)}
  .editorial-hero__eyebrow{margin:0 0 10px;color:#77dff6;font-size:.78rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase}
  .editorial-hero h1{margin:0 0 14px;font-size:clamp(2.15rem,4.6vw,4rem);line-height:1.02;letter-spacing:-.045em}
  .editorial-hero__copy>p:last-child{max-width:600px;margin:0;color:#e1e7f2;font-size:clamp(.95rem,1.25vw,1.08rem);line-height:1.65}
  @media(max-width:700px){.editorial-hero{aspect-ratio:auto;min-height:390px;max-height:none;border-radius:14px}.editorial-hero picture img{object-position:68% center}.editorial-hero__shade{background:linear-gradient(90deg,rgb(7 21 47 / .96) 0%,rgb(7 21 47 / .82) 58%,rgb(7 21 47 / .38) 100%)}.editorial-hero__copy{justify-content:flex-end;padding:28px 24px 34px}.editorial-hero h1{font-size:clamp(2rem,9vw,3rem)}}
</style>
