---
const links = [
  ["Inicio", "/"], ["Laptops", "/categorias/laptops-gaming"], ["Teclados", "/categorias/teclados-mecanicos"],
  ["Ratones", "/categorias/ratones-gaming"], ["Audio", "/categorias/audio-gaming"],
  ["Monitores", "/categorias/monitores-gaming"], ["Setup", "/categorias/setup-gaming"], ["Guías", "/guias"],
];
const groups = [
  ["Computación", ["Laptops gaming", "Componentes", "Almacenamiento", "Refrigeración"]],
  ["Periféricos", ["Teclados", "Ratones", "Alfombrillas", "Controles"]],
  ["Audio y video", ["Auriculares", "Micrófonos", "Webcams", "Monitores"]],
  ["Setup", ["Sillas", "Escritorios", "Iluminación", "Organización"]],
];
---
<nav class="primary-nav" aria-label="Navegación principal">
  <div class="nav-inner container">
    <a class="active" href="/" aria-current="page">Inicio</a>
    <div class="category-menu">
      <button type="button" data-mega-trigger aria-expanded="false" aria-controls="mega-menu">Categorías <span aria-hidden="true">⌄</span></button>
      <div id="mega-menu" class="mega surface" hidden>
        {groups.map(([title, items]) => <section><h2>{title}</h2><ul>{(items as string[]).map((item) => <li><a href={`/categorias/${item.toLowerCase().replaceAll(" ", "-")}`}>{item}</a></li>)}</ul></section>)}
        <a class="mega-feature" href="/seleccion">Explorar selección NEXBYTE <span aria-hidden="true">→</span></a>
      </div>
    </div>
    {links.slice(1).map(([label, href]) => <a href={href}>{label}</a>)}
  </div>
</nav>

<style>
  .primary-nav { border-top: 1px solid #edf0f5; border-bottom: 1px solid var(--color-border); background: #fff; }
  .nav-inner { min-height: 48px; display: flex; align-items: stretch; justify-content: center; gap: clamp(12px, 2.1vw, 32px); }
  .primary-nav a, .primary-nav button { position: relative; display: inline-flex; align-items: center; border: 0; background: transparent; min-height: 48px; padding: 0 2px; color: #34405a; font-size: .88rem; font-weight: 650; cursor: pointer; white-space: nowrap; }
  .primary-nav a:hover, .primary-nav button:hover { color: var(--color-violet); }
  .primary-nav .active::after { content:""; position:absolute; inset:auto 0 0; height:2px; background:var(--color-violet); }
  .category-menu { position: relative; display: flex; }
  .mega { position: absolute; z-index: 30; top: calc(100% + 9px); left: -95px; width: min(850px, calc(100vw - 48px)); padding: 28px; display: grid; grid-template-columns: repeat(4,1fr); gap: 26px; transform-origin: top; animation: mega-in 200ms var(--ease-out); }
  .mega[hidden] { display:none; }
  .mega h2 { margin:0 0 9px; font-size:.9rem; }
  .mega ul { list-style:none; margin:0; padding:0; }
  .mega li a { min-height:33px; color:var(--color-text-muted); font-weight:500; }
  .mega-feature { grid-column:1/-1; border-radius:12px; padding:14px 18px !important; background:var(--color-surface-soft) !important; color:var(--color-violet) !important; justify-content:space-between; }
  @keyframes mega-in { from { opacity:0; transform:translateY(8px) scale(.985); } }
  @media(max-width:1023px) { .primary-nav { display:none; } }
</style>
