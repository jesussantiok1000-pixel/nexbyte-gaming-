---
import PrimaryNavigation from "./PrimaryNavigation.astro";
---
<header class="site-header" data-header>
  <div class="header-main container">
    <a class="logo" href="/" aria-label="NEXBYTE, tecnología para subir de nivel"><strong>NEX<span>BYTE</span></strong><small>Tecnología para subir de nivel</small></a>
    <form class="search" role="search" action="/buscar">
      <label class="sr-only" for="site-search">Buscar productos, marcas o guías</label>
      <input id="site-search" name="q" type="search" placeholder="Buscar productos, marcas o guías…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-suggestions" />
      <button type="submit" aria-label="Buscar">⌕</button>
      <div id="search-suggestions" class="suggestions surface" role="listbox" hidden></div>
    </form>
    <div class="header-actions">
      <a href="/comparar" aria-label="Comparar productos"><span aria-hidden="true">⚖</span><span class="action-label">Comparar</span><b data-compare-count hidden>0</b></a>
      <a href="/favoritos" aria-label="Favoritos guardados"><span aria-hidden="true">♡</span><span class="action-label">Favoritos</span><b data-favorite-count hidden>0</b></a>
      <button class="menu-button" type="button" data-mobile-trigger aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">☰</button>
    </div>
  </div>
  <PrimaryNavigation />
  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-top"><strong>Navegación</strong><button type="button" data-mobile-close aria-label="Cerrar menú">×</button></div>
    <details><summary>Categorías</summary><a href="/categorias/laptops-gaming">Laptops</a><a href="/categorias/teclados-mecanicos">Teclados</a><a href="/categorias/ratones-gaming">Ratones</a><a href="/categorias/audio-gaming">Audio</a></details>
    <a href="/">Inicio</a><a href="/categorias/monitores-gaming">Monitores</a><a href="/categorias/setup-gaming">Setup</a><a href="/guias">Guías</a>
  </div>
</header>

<script>
  const megaTrigger = document.querySelector<HTMLElement>("[data-mega-trigger]");
  const mega = document.querySelector<HTMLElement>("#mega-menu");
  const closeMega = () => { if (mega && megaTrigger) { mega.hidden = true; megaTrigger.setAttribute("aria-expanded", "false"); } };
  megaTrigger?.addEventListener("click", () => { const open = mega?.hidden; if (mega) mega.hidden = !open; megaTrigger.setAttribute("aria-expanded", String(open)); });
  document.addEventListener("click", (event) => { if (!(event.target as Element).closest(".category-menu")) closeMega(); });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") { closeMega(); megaTrigger?.focus(); } });
  const header = document.querySelector("[data-header]");
  addEventListener("scroll", () => header?.classList.toggle("scrolled", scrollY > 20), { passive:true });

  const mobileTrigger = document.querySelector<HTMLElement>("[data-mobile-trigger]");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
  const closeMobile = () => { if (!mobileMenu || !mobileTrigger) return; mobileMenu.hidden = true; mobileTrigger.setAttribute("aria-expanded","false"); document.body.style.overflow=""; mobileTrigger.focus(); };
  mobileTrigger?.addEventListener("click", () => { if (!mobileMenu) return; mobileMenu.hidden=false; mobileTrigger.setAttribute("aria-expanded","true"); document.body.style.overflow="hidden"; mobileMenu.querySelector<HTMLElement>("button")?.focus(); });
  document.querySelector("[data-mobile-close]")?.addEventListener("click", closeMobile);
  document.addEventListener("keydown", e => { if (e.key==="Escape" && mobileMenu && !mobileMenu.hidden) closeMobile(); });

  const input = document.querySelector<HTMLInputElement>("#site-search");
  const panel = document.querySelector<HTMLElement>("#search-suggestions");
  const suggestions = ["Laptop gaming", "Teclados mecánicos", "Ratones inalámbricos", "Guía para tu setup", "Monitores gaming", "Auriculares"];
  let timer = 0;
  input?.addEventListener("input", () => {
    clearTimeout(timer); const query=input.value.trim().toLowerCase();
    if (query.length<2) { if(panel) panel.hidden=true; input.setAttribute("aria-expanded","false"); return; }
    timer=window.setTimeout(()=>{ if(!panel)return; const found=suggestions.filter(x=>x.toLowerCase().includes(query)).slice(0,6); panel.innerHTML=`<strong>Sugerencias</strong>${found.map(x=>`<a role="option" href="/buscar?q=${encodeURIComponent(x)}">${x}</a>`).join("")}`; panel.hidden=!found.length; input.setAttribute("aria-expanded",String(Boolean(found.length))); },250);
  });
</script>

<style>
  .site-header { position:sticky; top:0; z-index:40; background:rgb(255 255 255 / .95); backdrop-filter:blur(14px); transition:box-shadow var(--motion-normal); }
  .site-header.scrolled { box-shadow:0 10px 28px rgb(18 30 55 / .1); }
  .header-main { min-height:82px; display:grid; grid-template-columns:220px minmax(300px,1fr) auto; align-items:center; gap:28px; }
  .logo { display:flex; flex-direction:column; line-height:1; }
  .logo strong { font-size:1.75rem; letter-spacing:.15em; font-weight:800; }.logo strong span { color:var(--color-violet); }.logo small { margin-top:6px; color:#46536d; font-size:.7rem; }
  .search { position:relative; display:flex; height:46px; border:1px solid var(--color-border); border-radius:12px; background:#f9fbff; box-shadow:inset 0 1px 2px rgb(20 30 50 / .02); }
  .search:focus-within { border-color:var(--color-violet); box-shadow:0 0 0 3px rgb(109 58 232 / .12); }.search input { width:100%; border:0; outline:0; background:transparent; padding:0 15px; color:var(--color-text); }.search button { width:50px; border:0; background:transparent; font-size:1.6rem; cursor:pointer; }
  .suggestions { position:absolute; inset:calc(100% + 8px) 0 auto; z-index:20; display:flex; flex-direction:column; padding:12px; animation:mega-in 180ms var(--ease-out); }.suggestions[hidden]{display:none}.suggestions strong{font-size:.75rem;color:var(--color-text-muted);padding:5px 10px}.suggestions a{padding:9px 10px;border-radius:8px}.suggestions a:hover{background:var(--color-surface-soft);color:var(--color-violet)}
  .header-actions { display:flex; gap:7px; }.header-actions>a,.menu-button { min-width:48px; min-height:48px; display:flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:12px;background:transparent;padding:0 10px;position:relative;font-size:.85rem;cursor:pointer}.header-actions>a:hover,.menu-button:hover{background:var(--color-surface-soft);color:var(--color-violet)}.header-actions>a>span:first-child{font-size:1.5rem}.header-actions b{position:absolute;top:0;right:1px;display:grid;place-items:center;min-width:19px;height:19px;border-radius:50%;background:var(--color-violet);color:#fff;font-size:.68rem}
  .menu-button{display:none;font-size:1.3rem}.mobile-menu{position:fixed;z-index:60;inset:0 0 0 auto;width:min(88vw,380px);padding:24px;background:#fff;box-shadow:-20px 0 60px rgb(7 21 47 / .25);overflow:auto}.mobile-menu[hidden]{display:none}.mobile-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.mobile-top button{width:44px;height:44px;border:0;border-radius:50%;font-size:1.7rem;background:var(--color-surface-soft)}.mobile-menu>a,.mobile-menu details>a,.mobile-menu summary{display:block;padding:14px 8px;border-bottom:1px solid var(--color-border);font-weight:650}.mobile-menu details>a{padding-left:24px;color:var(--color-text-muted)}
  @media(max-width:1023px){.header-main{grid-template-columns:1fr auto;gap:14px;padding-block:12px}.search{grid-row:2;grid-column:1/-1}.menu-button{display:flex}.action-label{display:none}.logo small{display:none}}
  @media(max-width:479px){.header-main{width:calc(100% - 24px)}.logo strong{font-size:1.25rem}.header-actions{gap:0}.header-actions>a,.menu-button{padding:0;min-width:42px}}
</style>
