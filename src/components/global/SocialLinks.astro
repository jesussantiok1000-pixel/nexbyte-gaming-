---
import "@fortawesome/fontawesome-free/css/fontawesome.css";
import "@fortawesome/fontawesome-free/css/brands.css";
import { configuredSocialProfiles, type SocialNetwork } from "../../config/site";
interface Props { location:"header"|"mobile_menu"|"footer"|"author_page"|"about_page"; showLabels?:boolean }
const { location, showLabels=false }=Astro.props;
const labels:Record<SocialNetwork,string>={youtube:"YouTube",instagram:"Instagram",tiktok:"TikTok",pinterest:"Pinterest",facebook:"Facebook",x:"X"};
const iconClasses:Record<SocialNetwork,string>={
  youtube:"fa-youtube",
  instagram:"fa-instagram",
  tiktok:"fa-tiktok",
  pinterest:"fa-pinterest-p",
  facebook:"fa-facebook-f",
  x:"fa-x-twitter",
};
---
{configuredSocialProfiles.length>0&&<div class:list={["social-links",`social-links--${location}`,{"social-links--labels":showLabels}]} aria-label="Redes sociales de NEXBYTE">
  {configuredSocialProfiles.map(([network,url])=><a href={url} target="_blank" rel="me noopener noreferrer" aria-label={`Visitar NEXBYTE en ${labels[network]}`} data-social-link data-social-network={network} data-link-location={location}>
    <i class:list={["fa-brands",iconClasses[network]]} aria-hidden="true"></i>{showLabels&&<span>{labels[network]}</span>}
  </a>)}
</div>}
<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-social-link]").forEach(link=>link.addEventListener("click",()=>{
    const detail={event:"click_social",social_network:link.dataset.socialNetwork,link_location:link.dataset.linkLocation,destination_url:link.href};
    window.dispatchEvent(new CustomEvent("nexbyte:analytics",{detail}));
  }));
</script>
<style>
  .social-links{display:flex;align-items:center;gap:4px}.social-links a{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:8px;color:var(--color-text);transition:color 180ms ease,background-color 180ms ease,transform 180ms ease}.social-links i{width:20px;text-align:center;font-size:20px}.social-links a:hover{color:var(--color-violet);background:var(--color-surface-soft);transform:translateY(-1px)}.social-links a:focus-visible{outline:2px solid var(--color-violet);outline-offset:2px}.social-links--labels a{width:auto;padding-inline:8px}.social-links--footer,.social-links--footer a{color:#c6d0e1}@media(max-width:1180px){.social-links--header a:nth-child(n+4){display:none}}@media(max-width:1023px){.social-links--header{display:none}.social-links--mobile_menu{margin-top:10px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.social-links a{transition:none}.social-links a:hover{transform:none}}
</style>
