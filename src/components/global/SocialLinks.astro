---
import { configuredSocialProfiles, type SocialNetwork } from "../../config/site";
interface Props { location:"header"|"mobile_menu"|"footer"|"author_page"|"about_page"; showLabels?:boolean }
const { location, showLabels=false }=Astro.props;
const labels:Record<SocialNetwork,string>={youtube:"YouTube",instagram:"Instagram",tiktok:"TikTok",pinterest:"Pinterest",facebook:"Facebook",x:"X"};
const paths:Record<SocialNetwork,string>={
  youtube:'<path d="M21 12s0-3.2-.4-4.7a2.6 2.6 0 0 0-1.8-1.8C17.2 5 12 5 12 5s-5.2 0-6.8.5a2.6 2.6 0 0 0-1.8 1.8C3 8.8 3 12 3 12s0 3.2.4 4.7a2.6 2.6 0 0 0 1.8 1.8C6.8 19 12 19 12 19s5.2 0 6.8-.5a2.6 2.6 0 0 0 1.8-1.8C21 15.2 21 12 21 12Z"/><path d="m10 9 5 3-5 3Z"/>',
  instagram:'<rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.4" cy="6.7" r=".8" fill="currentColor" stroke="none"/>',
  tiktok:'<path d="M14 4v10.2a4.2 4.2 0 1 1-3.5-4.1"/><path d="M14 4c.7 2.4 2.2 3.8 4.5 4.2"/>',
  pinterest:'<path d="M9.2 20c.9-2.8 1.4-4.4 1.9-7.3-.3-.8-.4-1.8-.1-2.7.5-1.7 2.4-1.7 2.7-.4.3 1-1 2.6-1 4 0 1.2 1 2.1 2.2 2.1 2.7 0 4.3-3.4 4.3-6.2 0-2.6-2.2-4.6-5.5-4.6-4 0-6.4 3-6.4 5.9 0 1.1.4 2.4 1.2 3.1"/><path d="M8.5 17.8a8 8 0 1 1 5.1 2.1"/>',
  facebook:'<path d="M14 21v-8h3l.5-3H14V8.2c0-.9.4-1.7 1.8-1.7H18V4a28 28 0 0 0-2.7-.2c-2.7 0-4.5 1.6-4.5 4.6V10H8v3h2.8v8"/>',
  x:'<path d="M5 4 19 20"/><path d="M19 4 5 20"/>',
};
---
{configuredSocialProfiles.length>0&&<div class:list={["social-links",`social-links--${location}`,{"social-links--labels":showLabels}]} aria-label="Redes sociales de NEXBYTE">
  {configuredSocialProfiles.map(([network,url])=><a href={url} target="_blank" rel="me noopener noreferrer" aria-label={`Visitar NEXBYTE en ${labels[network]}`} data-social-link data-social-network={network} data-link-location={location}>
    <svg aria-hidden="true" viewBox="0 0 24 24" set:html={paths[network]} />{showLabels&&<span>{labels[network]}</span>}
  </a>)}
</div>}
<script>
  document.querySelectorAll<HTMLAnchorElement>("[data-social-link]").forEach(link=>link.addEventListener("click",()=>{
    const detail={event:"click_social",social_network:link.dataset.socialNetwork,link_location:link.dataset.linkLocation,destination_url:link.href};
    window.dispatchEvent(new CustomEvent("nexbyte:analytics",{detail}));
  }));
</script>
<style>
  .social-links{display:flex;align-items:center;gap:4px}.social-links a{width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:8px;color:var(--color-text);transition:color 180ms ease,background-color 180ms ease,transform 180ms ease}.social-links svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.social-links a:hover{color:var(--color-violet);background:var(--color-surface-soft);transform:translateY(-1px)}.social-links a:focus-visible{outline:2px solid var(--color-violet);outline-offset:2px}.social-links--labels a{width:auto;padding-inline:8px}.social-links--footer,.social-links--footer a{color:#c6d0e1}@media(max-width:1180px){.social-links--header a:nth-child(n+4){display:none}}@media(max-width:1023px){.social-links--header{display:none}.social-links--mobile_menu{margin-top:10px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.social-links a{transition:none}.social-links a:hover{transform:none}}
</style>
