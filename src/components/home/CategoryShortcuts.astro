---
const categories = [
  ["▱","Laptops","/categorias/laptops-gaming","laptop"],["⌨","Teclados mecánicos","/categorias/teclados-mecanicos","keyboard"],
  ["♙","Ratones gaming","/categorias/ratones-gaming","mouse"],["♬","Auriculares","/categorias/audio-gaming","audio"],["▣","Monitores","/categorias/monitores-gaming","monitor"],
  ["♜","Setup gaming","/categorias/setup-gaming","setup"],["▦","Componentes","/categorias/componentes","component"],["⌁","Accesorios","/categorias/accesorios-gaming","accessory"],
];
---
<section class="shortcut-section container" aria-labelledby="shortcut-title">
  <p id="shortcut-title">Explora por categoría</p>
  <nav class="shortcuts" aria-label="Categorías destacadas">
    {categories.map(([icon,label,href,motion])=><a class="category-shortcut" href={href}><span aria-hidden="true" data-icon-motion={motion}>{icon}</span><span>{label}</span></a>)}
  </nav>
</section>
<style>
  .shortcut-section{padding-block:28px 10px}.shortcut-section>p{margin:0 auto 16px;max-width:920px;color:var(--color-text-muted);font-size:.78rem;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.shortcuts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;width:min(100%,920px);margin-inline:auto}.shortcuts a{height:66px;display:flex;align-items:center;justify-content:center;gap:9px;padding:10px 12px;border:1px solid var(--color-border);border-radius:12px;background:#fff;color:#34405a;font-size:.78rem;font-weight:650;text-align:center;white-space:nowrap}.shortcuts a>span:first-child{flex:0 0 auto;color:var(--color-cyan);font-size:1.35rem}.shortcuts a>span:last-child{position:relative;padding-bottom:3px}.shortcuts a>span:last-child::after{content:"";position:absolute;left:50%;right:50%;bottom:0;height:2px;border-radius:999px;background:var(--color-violet);transition:left 240ms var(--ease-smooth),right 240ms var(--ease-smooth)}.shortcuts a:hover>span:last-child::after,.shortcuts a:focus-visible>span:last-child::after{left:0;right:0}
  @media(max-width:1023px){.shortcuts{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.shortcuts a{min-width:165px;scroll-snap-align:start}}
</style>
