---
const categories = [
  ["✦","Selección NEXBYTE","/seleccion"],["▱","Laptops gaming","/categorias/laptops-gaming"],["⌨","Teclados mecánicos","/categorias/teclados-mecanicos"],
  ["♙","Ratones gaming","/categorias/ratones-gaming"],["♬","Auriculares","/categorias/audio-gaming"],["▣","Monitores","/categorias/monitores-gaming"],
  ["♜","Sillas gamer","/categorias/sillas-gaming"],["▦","Componentes","/categorias/componentes"],["⌁","Accesorios","/categorias/accesorios-gaming"],
];
---
<nav class="shortcuts container" aria-label="Categorías destacadas">
  {categories.map(([icon,label,href],i)=><a href={href} class:list={{selected:i===0}}><span aria-hidden="true">{icon}</span><span>{label}</span></a>)}
</nav>
<style>
  .shortcuts{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:10px;padding-block:16px 28px}.shortcuts a{min-height:64px;display:flex;align-items:center;justify-content:center;gap:9px;padding:8px;border:1px solid var(--color-border);border-radius:12px;background:#fff;color:#34405a;font-size:.75rem;font-weight:650;text-align:center;transition:transform var(--motion-normal),border-color var(--motion-normal),box-shadow var(--motion-normal)}.shortcuts a>span:first-child{color:var(--color-cyan);font-size:1.35rem}.shortcuts a:hover{transform:translateY(-2px);border-color:#9b79f4;box-shadow:0 8px 20px rgb(30 50 90 / .08)}.shortcuts a:hover>span:first-child,.shortcuts .selected{color:var(--color-violet)}.shortcuts .selected{border-color:var(--color-violet)}
  @media(max-width:1023px){.shortcuts{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.shortcuts a{min-width:165px;scroll-snap-align:start}}
</style>
