---
const guides=[
  ["Periféricos","Cómo elegir un teclado mecánico","Switches, formatos y funciones que realmente cambian tu experiencia.","6 min","⌨"],
  ["Computación","Qué revisar antes de comprar una laptop gaming","Una ruta clara para equilibrar pantalla, gráficos, memoria y refrigeración.","8 min","▱"],
  ["Setup","Cómo organizar un setup cómodo y funcional","Ergonomía, espacio y conexiones para trabajar y jugar mejor.","5 min","✦"],
];
---
<section class="guides container" aria-labelledby="guias-destacadas">
  <div class="section-top"><div><p class="eyebrow">Decide con contexto</p><h2 id="guias-destacadas" class="section-heading">Guías para elegir mejor</h2></div><a href="/guias">Ver todas las guías <span aria-hidden="true">→</span></a></div>
  <div class="guide-grid">{guides.map(([category,title,summary,time,icon],i)=><article class="guide-card surface"><a class="guide-visual" href={`/guias/${["elegir-teclado-mecanico","comprar-laptop-gaming","organizar-setup"][i]}`} aria-label={`Leer ${title}`}><span aria-hidden="true">{icon}</span></a><div><p>{category}</p><h3>{title}</h3><span>{summary}</span><a href={`/guias/${["elegir-teclado-mecanico","comprar-laptop-gaming","organizar-setup"][i]}`}>{time} de lectura <b aria-hidden="true">→</b></a></div></article>)}</div>
</section>
<style>
  .guides{padding-block:10px 86px}.section-top{display:flex;align-items:end;justify-content:space-between;margin-bottom:24px}.section-top>a{color:var(--color-violet);font-weight:750}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.guide-card{overflow:hidden}.guide-visual{height:190px;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 70% 20%,rgb(24 167 201 / .45),transparent 35%),linear-gradient(145deg,#0b1b39,#25205b)}.guide-visual span{font-size:5rem;color:#fff;transition:transform 200ms}.guide-card:hover .guide-visual span{transform:scale(1.02)}.guide-card>div{padding:20px}.guide-card p{margin:0;color:var(--color-violet);font-size:.75rem;font-weight:750}.guide-card h3{margin:6px 0;font-size:1.1rem}.guide-card div>span{display:block;color:var(--color-text-muted);font-size:.85rem}.guide-card div>a{display:inline-flex;gap:8px;margin-top:16px;color:var(--color-violet);font-size:.78rem;font-weight:750}.guide-card:hover b{transform:translateX(3px)}
  @media(max-width:767px){.guide-grid{grid-template-columns:1fr}.section-top{align-items:start;gap:18px;flex-direction:column}}
</style>
