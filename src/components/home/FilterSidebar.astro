<aside id="filter-panel" class="filters surface" aria-label="Filtros de productos">
  <div class="filter-head">
    <strong>Encuentra lo que encaja contigo</strong>
    <div>
      <button class="filter-reset" type="reset" form="filter-form" data-clear aria-label="Reiniciar filtros" title="Reiniciar filtros">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19">
          <path d="M4.8 8.2A8 8 0 1 1 4 14m.8-5.8V4m0 4.2H9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="filter-close" type="button" data-filter-close aria-label="Cerrar filtros">×</button>
    </div>
  </div>
  <form id="filter-form">
    <fieldset><legend>Tipo de producto</legend><label><input type="checkbox" name="categoria" value="Laptops" /> Laptops</label><label><input type="checkbox" name="categoria" value="Teclados" /> Teclados</label><label><input type="checkbox" name="categoria" value="Ratones" /> Ratones</label><label><input type="checkbox" name="categoria" value="Audio" /> Audio</label><label><input type="checkbox" name="categoria" value="Monitores" /> Monitores</label><label><input type="checkbox" name="categoria" value="Setup" /> Setup</label><label><input type="checkbox" name="categoria" value="Accesorios" /> Accesorios</label></fieldset>
    <fieldset><legend>Cómo se conecta</legend><label><input type="checkbox" name="conectividad" value="Inalámbrico" /> Inalámbrico</label><label><input type="checkbox" name="conectividad" value="USB" /> USB</label><label><input type="checkbox" name="conectividad" value="DisplayPort" /> DisplayPort</label><label><input type="checkbox" name="conectividad" value="Wi‑Fi" /> Wi‑Fi</label><label><input type="checkbox" name="conectividad" value="No aplica" /> No aplica</label></fieldset>
    <fieldset><legend>Para qué lo necesitas</legend><label><input type="checkbox" name="uso" value="gaming" /> Gaming</label><label><input type="checkbox" name="uso" value="streaming" /> Streaming</label><label><input type="checkbox" name="uso" value="productividad" /> Productividad</label><label><input type="checkbox" name="uso" value="ergonomia" /> Ergonomía</label></fieldset>
  </form>
</aside>
<style>
  .filters{position:sticky;top:155px;align-self:start;max-height:calc(100vh - 175px);overflow:auto;padding:18px}.filter-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.filter-head>div{display:flex;align-items:center;gap:4px}.filter-head button{border:0;background:transparent;color:var(--color-text-muted);font-size:.72rem;cursor:pointer}.filter-head button:hover{color:var(--color-violet)}.filter-reset{width:34px;height:34px;display:grid;place-items:center;padding:0;border-radius:5px!important;transition:color 180ms,background 180ms,transform 220ms var(--ease-smooth)}.filter-reset:hover,.filter-reset:focus-visible{background:#f1ecff;transform:rotate(-35deg)}.filter-reset svg{display:block}fieldset{border:0;border-top:1px solid var(--color-border);margin:0;padding:16px 0}legend{padding-top:14px;font-weight:750}fieldset label{display:flex;align-items:center;gap:9px;padding:6px 0;color:#4f5d76;font-size:.82rem}fieldset input{width:18px;height:18px;accent-color:var(--color-violet)}
  .filter-close{display:none;font-size:1.4rem}
  @media(max-width:1023px){.filters{display:none}.filters.mobile-open{display:block;position:fixed;z-index:70;inset:8vh 16px 16px;max-height:none;overflow:auto}.filter-close{display:inline-block}.filters.mobile-open::before{content:"";position:fixed;z-index:-1;inset:0;background:rgb(7 21 47 / .48)}}
</style>
