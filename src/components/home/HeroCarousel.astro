---
import "../../styles/hero-carousel.css";

type HeroSlide = {
  id: string;
  image: string;
  imageAvif: string;
  eyebrow: string;
  titleBefore: string;
  titleAccent: string;
  titleAfter?: string;
  description: string;
  primaryAction: { label:string; href:string };
  secondaryAction: { label:string; href:string };
};

const slides: HeroSlide[] = [
  {
    id:"ecosistema", image:"/images/heroes/hero-ecosistema.webp", imageAvif:"/images/heroes/hero-ecosistema.avif",
    eyebrow:"TU SETUP, TODO EN SINTONÍA", titleBefore:"Tecnología que ", titleAccent:"encaja contigo", titleAfter:".",
    description:"Encuentra equipos y accesorios para jugar, crear y disfrutar mejor cada día.",
    primaryAction:{label:"Explorar selección",href:"#seleccion-productos"}, secondaryAction:{label:"Ver categorías",href:"/categorias"},
  },
  {
    id:"precision", image:"/images/heroes/hero-precision.webp", imageAvif:"/images/heroes/hero-precision.avif",
    eyebrow:"PRECISIÓN EN CADA MOVIMIENTO", titleBefore:"Control que se siente ", titleAccent:"al instante", titleAfter:".",
    description:"Periféricos pensados para responder con rapidez, comodidad y estilo.",
    primaryAction:{label:"Explorar periféricos",href:"/categorias"}, secondaryAction:{label:"Ver guías",href:"/guias"},
  },
  {
    id:"calidad", image:"/images/heroes/hero-calidad.webp", imageAvif:"/images/heroes/hero-calidad.avif",
    eyebrow:"CALIDAD EN CADA DETALLE", titleBefore:"Elige tecnología que ", titleAccent:"valga la pena", titleAfter:".",
    description:"Materiales, ergonomía y especificaciones explicadas con claridad.",
    primaryAction:{label:"Conocer la selección",href:"/seleccion"}, secondaryAction:{label:"Nuestra metodología",href:"/metodologia"},
  },
  {
    id:"confianza", image:"/images/heroes/hero-confianza.webp", imageAvif:"/images/heroes/hero-confianza.avif",
    eyebrow:"DECIDE CON MÁS CLARIDAD", titleBefore:"Menos dudas. ", titleAccent:"Mejores elecciones", titleAfter:".",
    description:"Recomendaciones y guías para encontrar lo que realmente necesitas.",
    primaryAction:{label:"Ver recomendaciones",href:"/seleccion"}, secondaryAction:{label:"Explorar guías",href:"/guias"},
  },
];
---
<section class="hero-carousel container" data-hero-carousel aria-roledescription="carrusel" aria-label="Selección tecnológica NEXBYTE" tabindex="0">
  <div class="hero-track">
    {slides.map((slide,index)=><article
      class:list={["hero-slide",{"is-active":index===0}]}
      data-hero-slide
      role="group"
      aria-roledescription="diapositiva"
      aria-label={`${index + 1} de ${slides.length}`}
      aria-hidden={index===0 ? "false" : "true"}
      inert={index!==0}
    >
      <picture class="hero-picture">
        <source srcset={slide.imageAvif} type="image/avif" />
        <source srcset={slide.image} type="image/webp" />
        <img src={`/images/heroes/hero-${slide.id}.png`} alt="" width="2048" height="768" loading={index===0 ? "eager" : "lazy"} fetchpriority={index===0 ? "high" : "low"} />
      </picture>
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <p class="hero-eyebrow">{slide.eyebrow}</p>
        {index===0
          ? <h1>{slide.titleBefore}<span>{slide.titleAccent}</span>{slide.titleAfter}</h1>
          : <h2>{slide.titleBefore}<span>{slide.titleAccent}</span>{slide.titleAfter}</h2>}
        <p class="hero-description">{slide.description}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={slide.primaryAction.href}>{slide.primaryAction.label}<span aria-hidden="true">→</span></a>
          <a class="btn hero-secondary" href={slide.secondaryAction.href}>{slide.secondaryAction.label}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </article>)}
  </div>
  <div class="hero-controls" aria-label="Controles de presentación">
    <button class="hero-step" type="button" data-carousel-previous aria-label="Diapositiva anterior"><svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="m12.5 5-5 5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <div class="hero-dots">
      {slides.map((_,index)=><button type="button" data-carousel-dot={index} class:list={{active:index===0}} aria-label={`Mostrar diapositiva ${index + 1}`} aria-current={index===0 ? "true" : undefined}></button>)}
    </div>
    <button class="hero-step" type="button" data-carousel-next aria-label="Siguiente diapositiva"><svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="m7.5 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button class="hero-toggle" type="button" data-carousel-toggle aria-label="Pausar presentación" aria-pressed="false">
      <svg data-pause-icon aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M8 6v12M16 6v12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      <svg data-play-icon aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="m9 6 9 6-9 6Z" fill="currentColor"/></svg>
    </button>
  </div>
</section>
<script>
  import "../../scripts/hero-carousel";
</script>
