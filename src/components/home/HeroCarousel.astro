---
import "../../styles/hero-carousel.css";

type HeroSlide = {
  id: string;
  image: string;
  eyebrow: string;
  title: string;
  description: string;
  action: { label:string; href:string };
};

const slides: HeroSlide[] = [
  {
    id:"experiencia",
    image:"/images/hero/experiencia.jpg",
    eyebrow:"EXPERIENCIA",
    title:"Más que tecnología, una experiencia para disfrutar",
    description:"Descubre productos seleccionados para acompañarte cada día con comodidad, estilo y confianza.",
    action:{label:"Explorar recomendaciones",href:"#seleccion-productos"},
  },
  {
    id:"calidad",
    image:"/images/hero/calidad.jpg",
    eyebrow:"CALIDAD",
    title:"Calidad premium en las marcas que más inspiran",
    description:"Encuentra dispositivos reconocidos por su diseño, rendimiento y prestigio, ideales para quienes buscan lo mejor.",
    action:{label:"Ver productos destacados",href:"/seleccion"},
  },
  {
    id:"setup",
    image:"/images/hero/setup.jpg",
    eyebrow:"SETUP",
    title:"Completa tu estilo gaming",
    description:"Arma un setup con personalidad: accesorios, audio y tecnología pensados para jugar, crear y destacar.",
    action:{label:"Descubrir setup gaming",href:"/categorias/setup-gaming"},
  },
];
---
<section class="hero-carousel container" data-hero-carousel aria-roledescription="carrusel" aria-label="Selección tecnológica NEXBYTE" tabindex="0">
  <div class="hero-track">
    {slides.map((slide,index)=><article
      class:list={["hero-slide",{"is-active":index===0}]}
      data-hero-slide
      role="group"
      aria-roledescription="diapositiva"
      aria-label={`${index + 1} de ${slides.length}`}
      aria-hidden={index===0 ? "false" : "true"}
      inert={index!==0}
    >
      <picture class="hero-picture">
        <img src={slide.image} alt="" width="1024" height="700" loading={index===0 ? "eager" : "lazy"} fetchpriority={index===0 ? "high" : "low"} />
      </picture>
      <div class="hero-copy" data-theme={slide.id}>
        <p class="hero-eyebrow">{slide.eyebrow}</p>
        {index===0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
        <p class="hero-description">{slide.description}</p>
        <div class="hero-actions">
          <a class="btn hero-cta" href={slide.action.href}>{slide.action.label}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </article>)}
  </div>
  <div class="hero-arrows" aria-label="Controles de presentación">
    <button class="hero-arrow hero-arrow--previous" type="button" data-carousel-previous aria-label="Diapositiva anterior"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button class="hero-arrow hero-arrow--next" type="button" data-carousel-next aria-label="Siguiente diapositiva"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
  <div class="hero-pagination">
    <div class="hero-dots">
      {slides.map((_,index)=><button type="button" data-carousel-dot={index} class:list={{active:index===0}} aria-label={`Mostrar diapositiva ${index + 1}`} aria-current={index===0 ? "true" : undefined}></button>)}
    </div>
  </div>
</section>
<script>
  import "../../scripts/hero-carousel";
</script>
