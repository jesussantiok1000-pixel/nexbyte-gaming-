<section class="hero container" aria-labelledby="hero-title">
  <img src="/images/hero-nexbyte.png" alt="" width="2048" height="1024" fetchpriority="high" />
  <div class="hero-shade"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">Selección tecnológica NEXBYTE</p>
    <h1 id="hero-title">Tecnología para <span>subir de nivel</span></h1>
    <p>Análisis claros, comparativas útiles y productos seleccionados para mejorar tu juego y tu setup.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#seleccion-productos">Explorar selección <span aria-hidden="true">→</span></a>
      <a class="btn hero-secondary" href="/comparativas">Ver comparativas <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .hero { position:relative; isolation:isolate; min-height:460px; display:flex; align-items:center; overflow:hidden; margin-top:24px; border-radius:22px; background:var(--color-navy); color:#fff; box-shadow:0 22px 55px rgb(7 21 47 / .16); animation:hero-in 360ms both; }
  .hero img { position:absolute; z-index:-2; inset:0; width:100%; height:100%; object-fit:cover; animation:image-in 600ms var(--ease-out) both; }
  .hero-shade { position:absolute; z-index:-1; inset:0; background:linear-gradient(90deg, rgb(4 15 36 / .98) 0%, rgb(4 15 36 / .86) 39%, rgb(4 15 36 / .18) 67%, transparent); }
  .hero-content { width:min(590px,55%); padding:58px; }.hero-eyebrow { color:#77dff6; font-size:.78rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; animation:copy-in 400ms 40ms both; }
  h1 { margin:12px 0 18px; font-size:clamp(2.5rem,4.5vw,4.75rem); line-height:1.02; letter-spacing:-.055em; font-weight:800; animation:copy-in 400ms 80ms both; } h1 span { background:linear-gradient(100deg,#8d68ff,#cf63f1 55%,#43ccec);background-clip:text;color:transparent; }
  .hero-content>p:not(.hero-eyebrow){max-width:540px;margin:0;color:#d4dbea;font-size:1.06rem;line-height:1.65;animation:copy-in 400ms 120ms both}.hero-actions{display:flex;gap:14px;margin-top:29px;animation:copy-in 400ms 160ms both}.hero-secondary{color:#fff;border-color:rgb(255 255 255 / .5);background:rgb(255 255 255 / .04)}.hero-secondary:hover{background:rgb(255 255 255 / .1);border-color:#fff}.hero-secondary:hover span{transform:translateX(3px)}
  @keyframes hero-in{from{opacity:0}}@keyframes copy-in{from{opacity:0;transform:translateY(12px)}}@keyframes image-in{from{transform:scale(1.015)}}
  @media(max-width:767px){.hero{min-height:550px;align-items:flex-start;margin-top:16px}.hero img{height:47%;top:auto;object-position:70% center}.hero-shade{background:linear-gradient(180deg,var(--color-navy) 0%,var(--color-navy) 55%,rgb(7 21 47 / .45) 80%,rgb(7 21 47 / .2))}.hero-content{width:100%;padding:34px 24px}.hero-actions{flex-direction:column}.hero .btn{width:100%}}
</style>
