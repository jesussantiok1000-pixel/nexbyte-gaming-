---
import { approvedProducts as products } from "../../data/products";
import FilterSidebar from "./FilterSidebar.astro";
import ProductCard from "../product/ProductCard.astro";
---
<section id="seleccion-productos" class="explorer container" aria-labelledby="titulo-seleccion">
  <FilterSidebar />
  <div class="results">
    <div class="toolbar">
      <div><p class="eyebrow">NOVEDADES Y ESENCIALES</p><h2 id="titulo-seleccion" class="section-heading">Selecciones para cada forma de jugar</h2><span aria-live="polite" data-result-count>Explora {products.length} opciones para tu próximo setup</span></div>
      <div class="toolbar-actions"><button class="filter-mobile btn btn-secondary" type="button" aria-expanded="false" aria-controls="filter-panel">Filtros</button><label>Ordenar por: <select data-sort><option value="relevance">Relevancia</option><option value="name">Nombre</option></select></label><button type="button" title="Vista en cuadrícula" aria-label="Vista en cuadrícula" aria-pressed="true" class="view-active" data-view="grid">▦</button><button type="button" title="Vista en lista" aria-label="Vista en lista" aria-pressed="false" data-view="list">☰</button></div>
    </div>
    <div class="product-grid" data-product-grid>{products.map((product,index)=><ProductCard product={product} index={index}/>)}</div>
    <div class="empty surface" data-empty hidden><h3>Descubre otras opciones</h3><button class="btn btn-secondary" type="button" data-clear>Limpiar filtros</button><a class="btn btn-primary" href="/categorias">Explorar categorías</a></div>
  </div>
</section>
<script>
  const form=document.querySelector<HTMLFormElement>("#filter-form");
  const cards=[...document.querySelectorAll<HTMLElement>("[data-product]")];
  const count=document.querySelector<HTMLElement>("[data-result-count]");
  const empty=document.querySelector<HTMLElement>("[data-empty]");
  const grid=document.querySelector<HTMLElement>("[data-product-grid]");
  function applyFilters(){
    if(!form)return; grid?.classList.add("updating");
    const data=new FormData(form); const categories=data.getAll("categoria"); const connections=data.getAll("conectividad"); const uses=data.getAll("uso");
    const render=()=>{let visible=0; cards.forEach(card=>{const wasHidden=card.hidden;const usage=(card.dataset.usage??"").split("|");const show=(!categories.length||categories.includes(card.dataset.category??""))&&(!connections.length||connections.includes(card.dataset.connectivity??""))&&(!uses.length||uses.some(use=>usage.includes(String(use))));card.hidden=!show;if(show){visible++;if(wasHidden&&!matchMedia("(prefers-reduced-motion: reduce)").matches)card.animate([{opacity:0,transform:"translateY(20px)"},{opacity:1,transform:"translateY(0)"}],{duration:480,easing:"cubic-bezier(.22,1,.36,1)"});}});if(count){count.textContent=visible===0?"Descubre otras opciones":visible===1?"Una opción para explorar":`${visible} opciones para explorar`;count.classList.remove("is-updating");void count.offsetWidth;count.classList.add("is-updating");}if(empty)empty.hidden=visible>0;};
    const viewDocument=document as Document & {startViewTransition?:(callback:()=>void)=>unknown};if(viewDocument.startViewTransition)viewDocument.startViewTransition(render);else render();
    const params=new URLSearchParams();categories.forEach(v=>params.append("categoria",String(v).toLowerCase()));connections.forEach(v=>params.append("conectividad",String(v).toLowerCase()));uses.forEach(v=>params.append("uso",String(v).toLowerCase()));history.replaceState(null,"",`${location.pathname}${params.size?`?${params}`:""}`);
    setTimeout(()=>grid?.classList.remove("updating"),180);
  }
  form?.addEventListener("change",applyFilters);document.querySelectorAll("[data-clear]").forEach(button=>button.addEventListener("click",()=>{form?.reset();applyFilters()}));
  const filterPanel=document.querySelector<HTMLElement>(".filters");const filterButton=document.querySelector<HTMLElement>(".filter-mobile");const closeFilters=()=>{filterPanel?.classList.remove("mobile-open");filterButton?.setAttribute("aria-expanded","false");document.body.style.overflow="";filterButton?.focus()};filterButton?.addEventListener("click",()=>{filterPanel?.classList.add("mobile-open");filterButton.setAttribute("aria-expanded","true");document.body.style.overflow="hidden";filterPanel?.querySelector<HTMLInputElement>("input")?.focus()});document.querySelector("[data-filter-close]")?.addEventListener("click",closeFilters);document.addEventListener("keydown",event=>{if(event.key==="Escape"&&filterPanel?.classList.contains("mobile-open"))closeFilters()});
  const params=new URLSearchParams(location.search);form?.querySelectorAll<HTMLInputElement>("input").forEach(input=>{const values=params.getAll(input.name);input.checked=values.includes(input.value.toLowerCase())});applyFilters();
  const originalOrder=[...cards];document.querySelector<HTMLSelectElement>("[data-sort]")?.addEventListener("change",event=>{if(!grid)return;const byName=(event.target as HTMLSelectElement).value==="name";const ordered=byName?[...cards].sort((a,b)=>(a.dataset.title??"").localeCompare(b.dataset.title??"","es")):originalOrder;ordered.forEach(card=>grid.append(card));if(!matchMedia("(prefers-reduced-motion: reduce)").matches)grid.animate([{opacity:.55,transform:"translateY(8px)"},{opacity:1,transform:"translateY(0)"}],{duration:320,easing:"ease-out"});});
  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach(button=>button.addEventListener("click",()=>{const list=button.dataset.view==="list";grid?.classList.toggle("list-view",list);document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach(item=>{const active=item===button;item.classList.toggle("view-active",active);item.setAttribute("aria-pressed",String(active));});}));
</script>
<style>
  .explorer{display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px;padding-block:10px 82px;scroll-margin-top:160px}.toolbar{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:14px}.toolbar h2{font-size:1.55rem}.toolbar [data-result-count]{display:block;margin-top:7px;color:var(--color-text-muted);font-size:.8rem}.toolbar-actions{display:flex;align-items:center;gap:8px}.toolbar-actions label{height:44px;display:flex;align-items:center;border:1px solid var(--color-border);border-radius:10px;padding:0 12px;color:var(--color-text-muted);font-size:.76rem;background:#fff}.toolbar select{border:0;background:transparent;color:var(--color-text);font-weight:650}.toolbar-actions>button:not(.filter-mobile){width:44px;height:44px;border:1px solid var(--color-border);border-radius:10px;background:#fff;transition:color 160ms,background 160ms,border-color 160ms}.toolbar-actions>button:not(.filter-mobile):hover{border-color:var(--color-violet);color:var(--color-violet)}.toolbar-actions .view-active{color:#fff!important;background:var(--color-violet)!important}.filter-mobile{display:none}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;transition:opacity 150ms,transform 150ms}.product-grid.list-view{grid-template-columns:1fr}.product-grid.list-view :global(.product-card){display:grid;grid-template-columns:240px minmax(0,1fr);grid-template-areas:"image category" "image title" "image features" "image benefit" "image actions" "image note";grid-template-rows:auto auto 1fr auto auto auto;column-gap:20px}.product-grid.list-view :global(.product-image){grid-area:image}.product-grid.list-view :global(.category){grid-area:category}.product-grid.list-view :global(h3){grid-area:title}.product-grid.list-view :global(ul){grid-area:features}.product-grid.list-view :global(.benefit){grid-area:benefit}.product-grid.list-view :global(.card-actions){grid-area:actions}.product-grid.list-view :global(.product-card>small){grid-area:note}.product-grid.updating{opacity:.55;transform:translateY(6px)}.empty{padding:38px;text-align:center}.empty[hidden]{display:none}
  @media(max-width:1279px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:1023px){.explorer{grid-template-columns:1fr}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.filter-mobile{display:inline-flex}}@media(max-width:720px){.toolbar{align-items:flex-start;flex-direction:column}.toolbar-actions{width:100%;overflow:auto}.toolbar-actions label{margin-left:auto;white-space:nowrap}.toolbar-actions>button:not(.filter-mobile){display:none}}@media(max-width:479px){.product-grid{grid-template-columns:1fr}}
</style>
