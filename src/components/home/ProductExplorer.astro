---
import { products } from "../../data/products";
import FilterSidebar from "./FilterSidebar.astro";
import ProductCard from "../product/ProductCard.astro";
---
<section id="seleccion-productos" class="explorer container" aria-labelledby="titulo-seleccion">
  <FilterSidebar />
  <div class="results">
    <div class="toolbar">
      <div><p class="eyebrow">Catálogo curado</p><h2 id="titulo-seleccion" class="section-heading">Productos seleccionados</h2><span aria-live="polite" data-result-count>{products.length} resultados</span></div>
      <div class="toolbar-actions"><button class="filter-mobile btn btn-secondary" type="button">Filtros</button><label>Ordenar por: <select data-sort><option value="relevance">Relevancia</option><option value="recent">Más recientes</option></select></label><button type="button" aria-label="Vista cuadrícula" class="view-active">▦</button><button type="button" aria-label="Vista lista">☰</button></div>
    </div>
    <div class="product-grid" data-product-grid>{products.map((product,index)=><ProductCard product={product} index={index}/>)}</div>
    <div class="empty surface" data-empty hidden><h3>No encontramos productos con estos filtros.</h3><button class="btn btn-secondary" type="button" data-clear>Limpiar filtros</button><a class="btn btn-primary" href="/categorias">Explorar categorías</a></div>
    <button class="load-more btn btn-secondary" type="button">Cargar más productos</button>
  </div>
</section>
<script>
  const form=document.querySelector<HTMLFormElement>("#filter-form");
  const cards=[...document.querySelectorAll<HTMLElement>("[data-product]")];
  const count=document.querySelector<HTMLElement>("[data-result-count]");
  const empty=document.querySelector<HTMLElement>("[data-empty]");
  const grid=document.querySelector<HTMLElement>("[data-product-grid]");
  function applyFilters(){
    if(!form)return; grid?.classList.add("updating");
    const data=new FormData(form); const categories=data.getAll("categoria"); const connections=data.getAll("conectividad");
    let visible=0; cards.forEach(card=>{const show=(!categories.length||categories.includes(card.dataset.category??""))&&(!connections.length||connections.includes(card.dataset.connectivity??""));card.hidden=!show;if(show)visible++;});
    if(count)count.textContent=`${visible} ${visible===1?"resultado":"resultados"}`; if(empty)empty.hidden=visible>0;
    const params=new URLSearchParams();categories.forEach(v=>params.append("categoria",String(v).toLowerCase()));connections.forEach(v=>params.append("conectividad",String(v).toLowerCase()));history.replaceState(null,"",`${location.pathname}${params.size?`?${params}`:""}`);
    setTimeout(()=>grid?.classList.remove("updating"),130);
  }
  form?.addEventListener("change",applyFilters);document.querySelectorAll("[data-clear]").forEach(button=>button.addEventListener("click",()=>{form?.reset();applyFilters()}));
  const params=new URLSearchParams(location.search);form?.querySelectorAll<HTMLInputElement>("input").forEach(input=>{const values=params.getAll(input.name);input.checked=values.includes(input.value.toLowerCase())});applyFilters();
</script>
<style>
  .explorer{display:grid;grid-template-columns:280px minmax(0,1fr);gap:22px;padding-block:24px 82px;scroll-margin-top:160px}.toolbar{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:18px}.toolbar h2{font-size:1.55rem}.toolbar [data-result-count]{display:block;margin-top:7px;color:var(--color-text-muted);font-size:.8rem}.toolbar-actions{display:flex;align-items:center;gap:8px}.toolbar-actions label{height:44px;display:flex;align-items:center;border:1px solid var(--color-border);border-radius:10px;padding:0 12px;color:var(--color-text-muted);font-size:.76rem;background:#fff}.toolbar select{border:0;background:transparent;color:var(--color-text);font-weight:650}.toolbar-actions>button:not(.filter-mobile){width:44px;height:44px;border:1px solid var(--color-border);border-radius:10px;background:#fff}.toolbar-actions .view-active{color:#fff!important;background:var(--color-violet)!important}.filter-mobile{display:none}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;transition:opacity 130ms,transform 130ms}.product-grid.updating{opacity:.55;transform:translateY(6px)}.empty{padding:38px;text-align:center}.empty[hidden]{display:none}.load-more{display:flex;margin:24px auto 0}
  @media(max-width:1279px){.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:1023px){.explorer{grid-template-columns:1fr}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.filter-mobile{display:inline-flex}}@media(max-width:720px){.toolbar{align-items:flex-start;flex-direction:column}.toolbar-actions{width:100%;overflow:auto}.toolbar-actions label{margin-left:auto;white-space:nowrap}.toolbar-actions>button:not(.filter-mobile){display:none}}@media(max-width:479px){.product-grid{grid-template-columns:1fr}}
</style>
