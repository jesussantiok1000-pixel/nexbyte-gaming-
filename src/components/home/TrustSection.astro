---
const points=[["◎","Selección enfocada en utilidad","Priorizamos características que ayudan a tomar una decisión."],["⚖","Comparativas claras","Explicamos diferencias sin rankings ni puntuaciones inventadas."],["◇","Enlaces transparentes","Identificamos cada salida comercial como enlace de afiliado."],["↻","Datos sujetos a Amazon","Precio y disponibilidad se confirman siempre en el destino."]];
---
<section class="trust" aria-labelledby="confianza-title"><div class="container"><p class="eyebrow">Nuestro compromiso</p><h2 id="confianza-title" class="section-heading">Recomendaciones con criterio y transparencia</h2><div class="trust-grid">{points.map(([icon,title,text])=><article><span aria-hidden="true">{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div><a href="/metodologia">Conoce nuestra metodología <span aria-hidden="true">→</span></a></div></section>
<style>.trust{padding-block:76px;background:var(--color-surface-soft)}.trust .section-heading{max-width:650px}.trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:30px 0}.trust article{border-left:2px solid #c9b9f4;padding:4px 18px}.trust article>span{color:var(--color-violet);font-size:1.6rem}.trust h3{margin:9px 0 5px;font-size:1rem}.trust p{margin:0;color:var(--color-text-muted);font-size:.82rem}.trust a{color:var(--color-violet);font-weight:750}@media(max-width:767px){.trust-grid{grid-template-columns:1fr 1fr}}@media(max-width:479px){.trust-grid{grid-template-columns:1fr}}</style>
