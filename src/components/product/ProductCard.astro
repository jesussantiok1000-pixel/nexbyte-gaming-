---
import type { ProductCardData } from "../../data/products";
interface Props { product: ProductCardData; index: number; }
const { product, index } = Astro.props;
---
<article class="product-card surface" data-product data-category={product.category} data-connectivity={product.connectivity} data-asin={product.asin} data-title={product.title}>
  <div class="product-image">
    <a href={`/producto/${product.slug}`} aria-label={`Ver análisis: ${product.title}`}><img src={product.imageUrl} alt={product.imageAlt} width="420" height="290" loading={index < 4 ? "eager" : "lazy"} /></a>
    <button class="favorite" type="button" data-favorite aria-pressed="false" aria-label={`Añadir ${product.title} a favoritos`}>♡</button>
  </div>
  <label class="compare"><input type="checkbox" data-compare /> Comparar</label>
  <p class="category">{product.category}</p>
  <h3><a href={`/producto/${product.slug}`}>{product.title}</a></h3>
  <ul>{product.features.map(feature=><li>{feature}</li>)}</ul>
  <p class="provisional">Selección editorial · ficha sin precio</p>
  <div class="card-actions">
    <a class="btn btn-secondary" href={`/producto/${product.slug}`}>Ver análisis</a>
    <a class="btn btn-primary affiliate-link" href={product.affiliateUrl} target="_blank" rel="sponsored nofollow noopener">Ver precio en Amazon</a>
  </div>
  <small>Enlace de afiliado <span aria-hidden="true">ⓘ</span></small>
</article>
<style>
  .product-card{display:flex;flex-direction:column;min-width:0;padding:12px;transition:transform 200ms var(--ease-out),border-color 200ms,box-shadow 200ms}.product-card:hover{transform:translateY(-4px);border-color:#baa8ed;box-shadow:0 16px 34px rgb(20 35 70 / .12)}.product-card:focus-within{border-color:var(--color-violet)}.product-image{position:relative;aspect-ratio:1.35;display:grid;place-items:center;overflow:hidden;border-radius:12px;background:linear-gradient(145deg,#f7f9fd,#edf1f8)}.product-image img{width:100%;height:100%;object-fit:contain;transition:transform 200ms}.product-card:hover .product-image img{transform:scale(1.025)}.favorite{position:absolute;top:4px;right:4px;width:44px;height:44px;border:0;border-radius:50%;background:rgb(255 255 255 / .88);font-size:1.55rem;cursor:pointer}.favorite[aria-pressed="true"]{color:var(--color-violet);background:#f0eaff}.compare{display:flex;align-items:center;gap:7px;margin:10px 2px 3px;color:#58657d;font-size:.75rem}.compare input{width:18px;height:18px;accent-color:var(--color-violet)}.category{margin:6px 2px 0;color:var(--color-violet);font-size:.72rem;font-weight:750}.product-card h3{margin:2px 2px 7px;font-size:1rem;line-height:1.3}.product-card ul{display:flex;flex-wrap:wrap;gap:5px;list-style:none;margin:0 2px 10px;padding:0}.product-card li{border:1px solid var(--color-border);border-radius:999px;padding:3px 7px;color:#59667d;background:#f8faff;font-size:.66rem}.provisional{margin:auto 2px 10px;color:var(--color-text-muted);font-size:.7rem}.card-actions{display:grid;grid-template-columns:1fr 1.25fr;gap:7px}.card-actions .btn{min-height:40px;padding:7px;font-size:.68rem;text-align:center}.product-card small{margin:8px 2px 0;color:#778298;font-size:.65rem}
  @media(max-width:479px){.card-actions{grid-template-columns:1fr}.card-actions .btn{font-size:.78rem}}
</style>
