---
import { getValidAffiliateUrl, type ProductCardData } from "../../data/products";
interface Props { product: ProductCardData; index: number; }
const { product, index } = Astro.props;
const affiliateUrl = getValidAffiliateUrl(product.affiliateUrl);
---
<article class="product-card surface" data-product data-category={product.category} data-connectivity={product.connectivity} data-usage={product.usage.join("|")} data-filters={(product.filters ?? []).join("|")} data-slug={product.slug} data-title={product.title}>
  <div class="product-image product-card__image">
    <a href={product.analysisUrl} aria-label={`Conoce sus puntos clave: ${product.title}`}>
      <picture>
        <img src={product.image} alt={product.imageAlt} width="1536" height="1024" loading={index < 4 ? "eager" : "lazy"} />
      </picture>
    </a>
    <button class="favorite" type="button" data-favorite aria-pressed="false" aria-label={`Añadir ${product.title} a favoritos`}><span data-favorite-icon aria-hidden="true">♡</span></button>
  </div>
  <p class="category">{product.productType ?? product.category}</p>
  <h3><a href={product.analysisUrl}>{product.title}</a></h3>
  <ul class="product-tags" aria-label="Características destacadas">{product.features.slice(0,2).map(feature=><li>{feature}</li>)}</ul>
  <p class="benefit">{product.orientationText}</p>
  <div class="card-actions">
    <a class="btn btn-secondary" href={product.analysisUrl}>Ver detalles</a>
    {affiliateUrl
      ? <a class="btn amazon-button" href={affiliateUrl} target="_blank" rel="sponsored noopener noreferrer" aria-label={`Ver ${product.title} en Amazon (abre en una pestaña nueva)`}>
          <span class="amazon-mark" aria-hidden="true"><b>a</b><svg viewBox="0 0 22 8"><path d="M2 2.5c4.8 3.6 11.2 3.7 16.5.3M16.7 1.5l2.5.8-.8 2.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span>Ver en Amazon</span><span class="external-arrow" aria-hidden="true">↗</span>
        </a>
      : <button class="btn btn-primary availability-disabled" type="button" disabled title="Enlace de Amazon pendiente">Ver disponibilidad</button>}
  </div>
</article>
<style>
  .product-card{display:flex;flex-direction:column;min-width:0;padding:12px;transition:transform 200ms var(--ease-out),border-color 200ms,box-shadow 200ms}.product-card:hover{transform:translateY(-4px);border-color:#baa8ed;box-shadow:0 16px 34px rgb(20 35 70 / .12)}.product-card:focus-within{border-color:var(--color-violet)}.product-image{position:relative;aspect-ratio:1.05;display:grid;place-items:center;overflow:hidden;border-radius:12px;background:linear-gradient(145deg,#f7f9fd,#edf1f8)}.product-image>a,.product-image picture{display:block;width:100%;height:100%}.product-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 200ms}.product-card:hover .product-image img{transform:scale(1.025)}.favorite{position:absolute;z-index:1;top:4px;right:4px;width:44px;height:44px;border:0;border-radius:50%;background:rgb(255 255 255 / .88);font-size:1.55rem;cursor:pointer}.favorite[aria-pressed="true"]{color:var(--color-violet);background:#f0eaff}.category{margin:12px 2px 0;color:var(--color-violet);font-size:.75rem;font-weight:750}.product-card h3{margin:2px 2px 8px;font-size:1rem;line-height:1.3}.product-tags{display:flex;flex-wrap:wrap;gap:5px;list-style:none;margin:0 2px 10px;padding:0}.product-tags li{padding:4px 7px;border:1px solid var(--color-border);background:#f8faff;color:#59667d;font-size:.68rem;line-height:1.25}.benefit{min-height:2.8em;margin:0 2px 14px;color:var(--color-text-muted);font-size:.75rem;line-height:1.45}.card-actions{display:grid;grid-template-columns:1fr 1.25fr;gap:7px;margin-top:auto}.card-actions .btn{min-height:44px;padding:7px;font-size:.75rem;text-align:center}
  .product-card{position:relative;overflow:hidden;transform:translateZ(0);transition:transform 340ms var(--ease-smooth),box-shadow 340ms var(--ease-smooth),border-color 240ms ease,background-color 240ms ease}.product-card:hover,.product-card:focus-within{transform:translate3d(0,-4px,0) scale(1.008);border-color:rgb(109 58 232 / .48);box-shadow:0 20px 45px rgb(16 24 43 / .12),0 8px 20px rgb(109 58 232 / .09)}.product-card__image img{transition:transform 520ms var(--ease-smooth),filter 340ms ease}.product-card:hover .product-card__image img,.product-card:focus-within .product-card__image img{transform:scale(1.04) translateY(-2px);filter:saturate(1.05) contrast(1.03)}.product-card__image::after{content:"";position:absolute;z-index:0;inset:0;background:linear-gradient(115deg,transparent 25%,rgb(255 255 255 / .32) 46%,transparent 67%);transform:translateX(-130%);transition:transform 650ms var(--ease-smooth);pointer-events:none}.product-card:hover .product-card__image::after,.product-card:focus-within .product-card__image::after{transform:translateX(130%)}.product-card .category,.product-card h3,.product-card .card-actions{transition:transform var(--motion-control) var(--ease-smooth)}.product-card:hover .category,.product-card:hover h3,.product-card:hover .card-actions,.product-card:focus-within .category,.product-card:focus-within h3,.product-card:focus-within .card-actions{transform:translateY(-2px)}
  /* Mantiene visible el producto completo, incluso en fotografías verticales o muy ajustadas. */
  .product-image{background:linear-gradient(145deg,#fff,#f3f6fb)}
  .product-image>a,.product-image picture{display:grid;place-items:center}
  .product-image img{box-sizing:border-box;padding:clamp(14px,5.5%,22px);object-fit:contain;object-position:center}
  .product-card[data-category="Ratones"] .product-image img{padding:clamp(26px,13%,42px)}
  .product-card:hover .product-image img,.product-card:focus-within .product-image img{transform:scale(1.01);filter:saturate(1.03) contrast(1.02)}
  @media(max-width:479px){.product-image img{padding:12px}.product-card[data-category="Ratones"] .product-image img{padding:22px}.card-actions{grid-template-columns:1fr}.card-actions .btn{font-size:.78rem}}
  .availability-disabled{opacity:.62;cursor:not-allowed;box-shadow:none}
  .amazon-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid #131921;background:#232f3e;color:#fff;box-shadow:0 8px 18px rgb(19 25 33 / .18)}
  .amazon-button:hover{border-color:#ffb84d;background:#131921;color:#fff;box-shadow:0 10px 22px rgb(19 25 33 / .25)}
  .amazon-button:focus-visible{outline:3px solid #ffb84d;outline-offset:2px}
  .amazon-mark{position:relative;display:inline-flex;width:23px;height:24px;flex:0 0 23px;align-items:flex-start;justify-content:center;color:#ff9900}
  .amazon-mark b{color:#fff;font:800 20px/18px Arial,sans-serif}
  .amazon-mark svg{position:absolute;left:1px;bottom:0;width:21px;height:8px}
  .external-arrow{color:#ffb84d;font-weight:900}
</style>
