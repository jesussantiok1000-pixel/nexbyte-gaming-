---
import type { ProductCardData } from "../../data/products";
interface Props { product: ProductCardData; index: number; }
const { product, index } = Astro.props;
---
<article class="product-card surface" data-product data-category={product.category} data-connectivity={product.connectivity} data-usage={product.usage.join("|")} data-slug={product.slug} data-title={product.title}>
  <div class="product-image product-card__image">
    <a href={product.analysisUrl} aria-label={`Conoce sus puntos clave: ${product.title}`}>
      <picture>
        <img src={product.image} alt={product.imageAlt} width="1536" height="1024" loading={index < 4 ? "eager" : "lazy"} />
      </picture>
    </a>
    <button class="favorite" type="button" data-favorite aria-pressed="false" aria-label={`Añadir ${product.title} a favoritos`}><span data-favorite-icon aria-hidden="true">♡</span></button>
  </div>
  <p class="category">{product.category}</p>
  <h3><a href={product.analysisUrl}>{product.title}</a></h3>
  <ul>{product.features.map(feature=><li>{feature}</li>)}</ul>
  <p class="provisional">{product.orientationText}</p>
  <div class="card-actions">
    <a class="btn btn-secondary" href={product.analysisUrl}>Conoce sus puntos clave</a>
    <a class="btn btn-primary" href={`${product.analysisUrl}#criterios-compra`}>Descubre si es para ti</a>
  </div>
  <small>Guía de elección <span aria-hidden="true">ⓘ</span></small>
</article>
<style>
  .product-card{display:flex;flex-direction:column;min-width:0;padding:12px;transition:transform 200ms var(--ease-out),border-color 200ms,box-shadow 200ms}.product-card:hover{transform:translateY(-4px);border-color:#baa8ed;box-shadow:0 16px 34px rgb(20 35 70 / .12)}.product-card:focus-within{border-color:var(--color-violet)}.product-image{position:relative;aspect-ratio:1.35;display:grid;place-items:center;overflow:hidden;border-radius:12px;background:linear-gradient(145deg,#f7f9fd,#edf1f8)}.product-image>a,.product-image picture{display:block;width:100%;height:100%}.product-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform 200ms}.product-card:hover .product-image img{transform:scale(1.025)}.favorite{position:absolute;z-index:1;top:4px;right:4px;width:44px;height:44px;border:0;border-radius:50%;background:rgb(255 255 255 / .88);font-size:1.55rem;cursor:pointer}.favorite[aria-pressed="true"]{color:var(--color-violet);background:#f0eaff}.category{margin:12px 2px 0;color:var(--color-violet);font-size:.75rem;font-weight:750}.product-card h3{margin:2px 2px 7px;font-size:1rem;line-height:1.3}.product-card ul{display:flex;flex-wrap:wrap;gap:5px;list-style:none;margin:0 2px 10px;padding:0}.product-card li{border:1px solid var(--color-border);border-radius:999px;padding:3px 7px;color:#59667d;background:#f8faff;font-size:.75rem}.provisional{margin:auto 2px 10px;color:var(--color-text-muted);font-size:.75rem}.card-actions{display:grid;grid-template-columns:1fr 1.25fr;gap:7px}.card-actions .btn{min-height:44px;padding:7px;font-size:.75rem;text-align:center}.product-card small{margin:8px 2px 0;color:#667085;font-size:.75rem}
  .product-card{position:relative;overflow:hidden;transform:translateZ(0);transition:transform 340ms var(--ease-smooth),box-shadow 340ms var(--ease-smooth),border-color 240ms ease,background-color 240ms ease}.product-card:hover,.product-card:focus-within{transform:translate3d(0,-4px,0) scale(1.008);border-color:rgb(109 58 232 / .48);box-shadow:0 20px 45px rgb(16 24 43 / .12),0 8px 20px rgb(109 58 232 / .09)}.product-card__image img{transition:transform 520ms var(--ease-smooth),filter 340ms ease}.product-card:hover .product-card__image img,.product-card:focus-within .product-card__image img{transform:scale(1.04) translateY(-2px);filter:saturate(1.05) contrast(1.03)}.product-card__image::after{content:"";position:absolute;z-index:0;inset:0;background:linear-gradient(115deg,transparent 25%,rgb(255 255 255 / .32) 46%,transparent 67%);transform:translateX(-130%);transition:transform 650ms var(--ease-smooth);pointer-events:none}.product-card:hover .product-card__image::after,.product-card:focus-within .product-card__image::after{transform:translateX(130%)}.product-card .category,.product-card h3,.product-card .card-actions{transition:transform var(--motion-control) var(--ease-smooth)}.product-card:hover .category,.product-card:hover h3,.product-card:hover .card-actions,.product-card:focus-within .category,.product-card:focus-within h3,.product-card:focus-within .card-actions{transform:translateY(-2px)}
  @media(max-width:479px){.card-actions{grid-template-columns:1fr}.card-actions .btn{font-size:.78rem}}
</style>
