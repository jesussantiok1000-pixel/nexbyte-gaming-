<div class="toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>
<style>.toast-region{position:fixed;z-index:80;right:20px;bottom:125px;display:flex;flex-direction:column;gap:8px}.toast{display:flex;align-items:center;gap:10px;max-width:360px;border-radius:12px;background:var(--color-navy);color:#fff;padding:12px 15px;box-shadow:0 12px 30px rgb(7 21 47 / .3);animation:toast-in 180ms var(--ease-out)}.toast button{margin-left:auto;border:0;background:transparent;color:#fff;font-size:1.2rem}@keyframes toast-in{from{opacity:0;transform:translateY(6px)}}</style>
