---
import "../styles/global.css";
import "../styles/motion.css";
import SiteHeader from "../components/global/SiteHeader.astro";
import SiteFooter from "../components/global/SiteFooter.astro";
import WhatsAppButton from "../components/global/WhatsAppButton.astro";
import BackButton from "../components/global/BackButton.astro";
import ToastRegion from "../components/ui/ToastRegion.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}

const {
  title = "NEXBYTE | Tecnología gaming, comparativas y recomendaciones",
  description = "Descubre productos gaming, comparativas claras y guías para elegir laptops, periféricos y accesorios para tu setup.",
  noindex = false,
  image = "/images/image-2.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const showBackButton = Astro.url.pathname !== "/";
const socialImage = new URL(image, canonical.origin);
const organization = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "NEXBYTE", url: canonical.origin },
    {
      "@type": "WebSite",
      name: "NEXBYTE",
      url: canonical.origin,
      potentialAction: {
        "@type": "SearchAction",
        target: `${canonical.origin}/buscar?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#07152f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido-principal">
      <slot />
      {showBackButton && <BackButton />}
    </main>
    <WhatsAppButton />
    <SiteFooter />
    <ToastRegion />
    <script>
      import "../scripts/interactions";
      import "../scripts/motion";
    </script>
  </body>
</html>
