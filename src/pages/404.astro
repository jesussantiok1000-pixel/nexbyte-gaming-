---
import BaseLayout from "../layouts/BaseLayout.astro"; import { categories } from "../data/categories";
---
<BaseLayout title="Página no disponible | NEXBYTE" description="La página solicitada no está disponible." noindex><div class="container page-shell not-found"><p class="code">404</p><h1>Esta página no está disponible</h1><p>Puede que la dirección haya cambiado. Usa la búsqueda o vuelve a una sección conocida.</p><form action="/buscar" role="search"><label class="sr-only" for="search-404">Buscar</label><input id="search-404" name="q" required minlength="2" placeholder="Buscar en NEXBYTE"/><button class="btn btn-primary">Buscar</button></form><p><a class="btn btn-primary" href="/">Volver al inicio</a> <a class="btn btn-secondary" href="/categorias">Explorar categorías</a></p><nav aria-label="Categorías populares">{categories.slice(0,4).map(category=><a href={`/categorias/${category.slug}`}>{category.shortName}</a>)}</nav></div></BaseLayout>
<style>.not-found{text-align:center;padding-block:70px 100px}.code{margin:0;font-size:clamp(6rem,20vw,13rem);line-height:.8;font-weight:900;color:var(--color-violet);opacity:.18}.not-found h1{font-size:clamp(2rem,5vw,3.5rem)}.not-found form{display:flex;max-width:600px;margin:28px auto;gap:8px}.not-found input{flex:1;border:1px solid var(--color-border);border-radius:12px;padding:12px}.not-found nav{display:flex;justify-content:center;flex-wrap:wrap;gap:16px;color:var(--color-violet)}@media(max-width:500px){.not-found form{flex-direction:column}}</style>
