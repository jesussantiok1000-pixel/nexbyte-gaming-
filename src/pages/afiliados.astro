---
import StaticPage from "../components/content/StaticPage.astro";
import { approvedProducts, getValidAffiliateUrl } from "../data/products";
const affiliateDisclosureEnabled = approvedProducts.some((product) => Boolean(getValidAffiliateUrl(product.affiliateUrl)));
const sections=[
  ...(affiliateDisclosureEnabled ? [{title:"Aviso de afiliación",text:"Como afiliado de Amazon, NEXBYTE puede obtener ingresos por compras que cumplan los requisitos."}] : []),
  {title:"Transparencia comercial",text:"Cuando una opción incluya un enlace de afiliado, se identificará de forma clara antes de dirigir al proveedor."},
  {title:"Selección independiente",text:"La posible existencia de una relación de afiliación no determina qué productos, categorías o características aparecen en NEXBYTE."},
  {title:"Disponibilidad externa",text:"Los precios, disponibilidad y condiciones de compra pertenecen al proveedor y deben confirmarse en su sitio antes de elegir."},
];
---
<StaticPage title="Afiliación y transparencia" description="Cómo identificamos relaciones comerciales y protegemos la independencia de nuestras selecciones." sections={sections}/>
