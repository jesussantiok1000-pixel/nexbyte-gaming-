---
import BaseLayout from "../../layouts/BaseLayout.astro"; import Breadcrumbs from "../../components/global/Breadcrumbs.astro"; import EditorialHero from "../../components/content/EditorialHero.astro"; import { comparisons } from "../../data/editorial";
---
<BaseLayout title="Comparativas de tecnología gaming | NEXBYTE" description="Comparativas editoriales con criterios claros."><div class="container page-shell"><Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Comparativas"}]}/><EditorialHero image="comparativa" eyebrow="Decide con contexto" title="Comparativas de tecnología gaming" description="Diferencias importantes explicadas según el uso, sin declarar ganadores universales." /><section class="content-grid">{comparisons.map(item=><article class="info-card surface"><p class="eyebrow">{item.category}</p><h2>{item.title}</h2><p>{item.description}</p><a class="link-arrow" href={`/comparativas/${item.slug}`}>Ver comparativa →</a></article>)}</section></div></BaseLayout>
