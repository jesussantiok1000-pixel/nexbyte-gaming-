---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/global/Breadcrumbs.astro";

const whatsappUrl =
  "https://wa.me/51904481656?text=Hola%2C%20encontr%C3%A9%20NEXBYTE%20Gaming%20y%20quisiera%20realizar%20una%20consulta.";
---

<BaseLayout title="Contacto por WhatsApp | NEXBYTE" description="Contacta con NEXBYTE para consultas sobre categorías, productos, guías y comparativas.">
  <div class="container page-shell">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Contacto"}]} />
    <header class="page-hero surface">
      <p class="eyebrow">CONTACTO NEXBYTE</p>
      <h1>¿En qué podemos ayudarte?</h1>
      <p>Escríbenos si necesitas orientación para explorar categorías, productos o colecciones.</p>
    </header>
    <section class="contact-card surface" aria-labelledby="whatsapp-heading">
      <div class="whatsapp-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="34" height="34"><path fill="currentColor" d="M16.02 4.67A11.2 11.2 0 0 0 6.3 21.43L4.7 27.3l6.01-1.58a11.2 11.2 0 1 0 5.31-21.05Zm0 20.5c-1.8 0-3.54-.52-5.04-1.5l-.36-.22-3.57.94.95-3.48-.24-.36a9.3 9.3 0 1 1 8.26 4.62Zm5.1-6.96c-.28-.14-1.65-.81-1.9-.9-.26-.1-.44-.14-.63.14-.19.28-.72.9-.88 1.09-.16.18-.33.2-.6.07-1.65-.83-2.74-1.48-3.84-3.35-.3-.5.3-.46.83-1.55.09-.19.05-.35-.02-.49-.07-.14-.63-1.52-.86-2.08-.23-.55-.46-.47-.63-.48h-.54c-.19 0-.49.07-.74.35-.26.28-.98.95-.98 2.32s1 2.7 1.13 2.88c.14.19 1.96 3 4.75 4.2.66.29 1.18.46 1.59.59.66.21 1.27.18 1.74.11.53-.08 1.65-.67 1.88-1.32.24-.65.24-1.2.17-1.32-.07-.12-.26-.19-.54-.33Z"/></svg>
      </div>
      <div class="contact-copy">
        <p class="contact-label">Atención por WhatsApp</p>
        <h2 id="whatsapp-heading">+51 904 481 656</h2>
        <p>Conversemos sobre productos, compatibilidad y opciones para mejorar tu setup.</p>
        <a class="whatsapp-action" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Conversar por WhatsApp</a>
        <p class="privacy-note">Al continuar, se abrirá WhatsApp y se aplicarán sus propias condiciones de privacidad.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-hero .eyebrow{color:#9fdff0}.contact-card{max-width:820px;margin-inline:auto;padding:clamp(24px,4vw,38px);display:grid;grid-template-columns:auto 1fr;gap:22px}.whatsapp-icon{width:60px;height:60px;display:grid;place-items:center;border-radius:16px;background:#168a52;color:#fff}.contact-copy h2{margin:2px 0 12px;font-size:clamp(1.55rem,4vw,2rem)}.contact-copy>p{color:var(--color-text-muted)}.contact-label{margin:0;color:var(--color-violet)!important;font-size:.8rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.whatsapp-action{min-height:48px;display:inline-flex;align-items:center;justify-content:center;margin-top:6px;padding:11px 19px;border:1px solid rgb(255 255 255/.3);border-radius:12px;background:#168a52;color:#fff;box-shadow:0 8px 18px rgb(22 138 82/.2);font-weight:800;transition:transform var(--motion-normal),filter var(--motion-normal),box-shadow var(--motion-normal)}.whatsapp-action:hover{transform:translateY(-2px);filter:brightness(1.08);box-shadow:0 11px 23px rgb(22 138 82/.27)}.privacy-note{margin:14px 0 0;font-size:.8rem}.editorial-note{max-width:820px;margin:20px auto 0;padding:24px 28px}.editorial-note h2{margin:0 0 8px;font-size:1.1rem}.editorial-note p{margin:0;color:var(--color-text-muted)}@media(max-width:560px){.contact-card{grid-template-columns:1fr}.whatsapp-icon{width:52px;height:52px}.whatsapp-action{width:100%}}@media(prefers-reduced-motion:reduce){.whatsapp-action{transition:none}}
</style>
