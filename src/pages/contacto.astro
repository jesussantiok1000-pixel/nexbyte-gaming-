---
import BaseLayout from "../layouts/BaseLayout.astro"; import Breadcrumbs from "../components/global/Breadcrumbs.astro";
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "";
---
<BaseLayout title="Contacto | NEXBYTE" description="Envía una consulta o corrección al equipo editorial de NEXBYTE."><div class="container page-shell"><Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Contacto"}]}/><header class="page-hero surface"><h1>Contacto</h1><p>Consultas editoriales, correcciones y transparencia.</p></header><form class="contact surface" data-contact-form><label>Nombre<input name="name" required minlength="2" maxlength="80" autocomplete="name"/></label><label>Correo<input name="email" type="email" required maxlength="254" autocomplete="email"/></label><label>Asunto<input name="subject" required minlength="3" maxlength="120"/></label><label>Mensaje<textarea name="message" required minlength="20" maxlength="2000" rows="7"></textarea></label><label class="consent"><input name="consent" type="checkbox" required/> He leído la <a href="/privacidad">política de privacidad</a>.</label><label class="honeypot" aria-hidden="true">Sitio web<input name="website" tabindex="-1" autocomplete="off"/></label><button class="btn btn-primary" type="submit" disabled={!contactEmail}>Preparar mensaje</button><p data-form-status role="status" aria-live="polite">{contactEmail ? "El envío abre tu aplicación de correo; NEXBYTE no almacena el mensaje en este sitio." : "El formulario de contacto estará disponible próximamente."}</p></form></div><script is:inline define:vars={{ contactEmail }}>const form=document.querySelector("[data-contact-form]"),status=document.querySelector("[data-form-status]");form?.addEventListener("submit",event=>{event.preventDefault();if(!contactEmail||!form.reportValidity())return;const data=new FormData(form);if(data.get("website"))return;const subject=String(data.get("subject")||"Consulta NEXBYTE"),body=`Nombre: ${String(data.get("name")||"")}\nCorreo: ${String(data.get("email")||"")}\n\n${String(data.get("message")||"")}`;if(status)status.textContent="Abriendo tu aplicación de correo…";location.href=`mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`})</script></BaseLayout>
<style>.contact{max-width:760px;margin:auto;padding:28px;display:grid;gap:18px}.contact label{display:grid;gap:7px;font-weight:700}.contact input,.contact textarea{border:1px solid var(--color-border);border-radius:10px;padding:12px;background:#fff}.contact .consent{display:flex;align-items:flex-start;font-weight:500}.contact .consent input{width:20px;height:20px}.contact a{color:var(--color-violet);text-decoration:underline}.honeypot{position:absolute!important;left:-10000px}</style>
