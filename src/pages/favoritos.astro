---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/global/Breadcrumbs.astro";
import ProductCard from "../components/product/ProductCard.astro";
import { approvedProducts } from "../data/products";
---
<BaseLayout title="Mis favoritos | NEXBYTE" description="Análisis guardados localmente en este navegador." noindex>
  <div class="container page-shell">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Favoritos"}]} />
    <header class="page-hero surface favorites-hero"><h1>Mis favoritos</h1><p>Se guardan únicamente en este navegador. No necesitas una cuenta ni compartir datos personales.</p></header>
    <div data-favorites-page class="saved-grid" aria-live="polite">
      {approvedProducts.map((product,index)=><div data-favorite-item={product.slug} hidden><ProductCard product={product} index={index+4}/></div>)}
    </div>
    <div data-favorites-empty class="empty-state surface"><h2>Todavía no guardaste ninguna opción</h2><p>Cuando encuentres algo interesante, toca el corazón para tenerlo siempre a mano.</p><a class="btn btn-primary" href="/categorias">Explorar categorías</a></div>
    <button data-clear-favorites class="btn btn-secondary" type="button" hidden>Limpiar favoritos</button>
  </div>
  <script is:inline>
    const key="nexbyte:favorites",root=document.querySelector("[data-favorites-page]"),empty=document.querySelector("[data-favorites-empty]"),clear=document.querySelector("[data-clear-favorites]");
    const readIds=()=>{try{const value=JSON.parse(localStorage.getItem(key)||"[]");return Array.isArray(value)?value:[]}catch{return[]}};
    const renderFavorites=()=>{
      const ids=readIds();let visible=0;
      document.querySelectorAll("[data-favorite-item]").forEach(item=>{const show=ids.includes(item.getAttribute("data-favorite-item"));item.hidden=!show;if(show)visible++});
      if(empty)empty.hidden=visible>0;if(clear)clear.hidden=visible===0;if(root)root.hidden=visible===0;
    };
    clear?.addEventListener("click",()=>{if(!confirm("¿Quieres eliminar todos tus favoritos guardados?"))return;localStorage.setItem(key,"[]");renderFavorites();window.dispatchEvent(new Event("nexbyte:favorites-changed"))});
    document.addEventListener("click",event=>{if(event.target.closest("[data-favorite]"))setTimeout(renderFavorites,0)});
    renderFavorites();
  </script>
</BaseLayout>
<style>
  .favorites-hero{min-height:300px;display:flex;flex-direction:column;justify-content:center;background-image:linear-gradient(90deg,rgb(7 21 47 / .96) 0%,rgb(12 30 73 / .84) 35%,rgb(12 30 73 / .18) 66%,transparent 100%),url("/images/favoritos.webp");background-position:center;background-size:cover;background-repeat:no-repeat;box-shadow:0 18px 42px rgb(22 35 71 / .14)}
  .favorites-hero h1,.favorites-hero p{position:relative;z-index:1}.favorites-hero p{max-width:560px;color:#e3eafa;text-shadow:0 1px 12px rgb(4 15 41 / .35)}
  .saved-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}.saved-grid>[data-favorite-item]{min-width:0}.saved-grid>[hidden],.saved-grid[hidden]{display:none}
  @media(max-width:800px){.favorites-hero{min-height:270px;background-position:58% center}.saved-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:520px){.favorites-hero{min-height:250px;padding:28px 24px;background-image:linear-gradient(90deg,rgb(7 21 47 / .94),rgb(12 30 73 / .65)),url("/images/favoritos.webp");background-position:62% center}.saved-grid{grid-template-columns:1fr}}
</style>
