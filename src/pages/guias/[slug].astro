---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/global/Breadcrumbs.astro";
import { guides } from "../../data/editorial";
import { approvedProducts } from "../../data/products";
import { siteConfig } from "../../config/site";
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}))}
const {guide}=Astro.props;
const related=approvedProducts.filter(product=>product.guideUrl===`/guias/${guide.slug}`).slice(0,3);
const canonical=new URL(`/guias/${guide.slug}`,Astro.site??Astro.url);
const schema={"@context":"https://schema.org","@type":"Article",headline:guide.title,description:guide.description,datePublished:"2026-07-23",dateModified:"2026-07-23",author:{"@type":"Person",name:siteConfig.author.name,url:new URL(siteConfig.author.url,siteConfig.url).href},publisher:{"@type":"Organization",name:"NEXBYTE"},mainEntityOfPage:canonical.href};
---
<BaseLayout title={`${guide.title} | NEXBYTE`} description={guide.description}>
  <div class="container page-shell">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Guías",href:"/guias"},{label:guide.title}]}/>
    <article class="prose surface info-card">
      <p class="eyebrow">{guide.category}</p><h1>{guide.title}</h1><p class="lead">{guide.description}</p>
      <p><strong>Investigado y redactado por:</strong> <a href="/autor/jesus-manuel">Jesús Manuel</a> · Publicado y actualizado el <time datetime="2026-07-23">23 de julio de 2026</time></p>
      <nav class="article-index" aria-label="Contenido"><h2>En esta guía</h2><ol>{guide.sections.map((section,index)=><li><a href={`#seccion-${index}`}>{section.title}</a></li>)}</ol></nav>
      {guide.sections.map((section,index)=><section id={`seccion-${index}`}><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}{section.points&&<ul>{section.points.map(point=><li>{point}</li>)}</ul>}</section>)}
      <section><h2>Conclusión</h2><p>Convierte tus necesidades en una lista breve y contrasta información verificable. No existe una opción universal: la mejor elección depende del uso, el espacio y la compatibilidad.</p></section>
      {related.length>0&&<aside class="related-links"><h2>Análisis relacionados</h2>{related.map(product=><a href={product.analysisUrl}>{product.title} →</a>)}</aside>}
      <p class="educational-note">Usa estos criterios como punto de partida y comprueba las características finales de la opción que estés considerando.</p>
    </article>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>
</BaseLayout>
<style>
  .lead{font-size:1.1rem}
  .article-index,.related-links,.educational-note{padding:18px;border-radius:12px;background:var(--color-surface-soft)}
  .article-index{margin:28px 0 34px}
  .article-index h2,.related-links h2{margin-top:0}
  .related-links{display:grid;gap:8px;margin-top:34px;border:1px solid var(--color-border)}
  .related-links a{color:var(--color-violet);font-weight:700}
  .educational-note{margin:16px 0 0;border:1px solid var(--color-border);border-left:4px solid var(--color-cyan);background:#eefaff}
</style>
