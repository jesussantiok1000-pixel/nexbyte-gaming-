---
import BaseLayout from "../../layouts/BaseLayout.astro"; import Breadcrumbs from "../../components/global/Breadcrumbs.astro"; import EditorialHero from "../../components/content/EditorialHero.astro"; import { guides } from "../../data/editorial";
---
<BaseLayout title="Guías para elegir tecnología gaming | NEXBYTE" description="Guías de compra, configuración y ergonomía para tecnología gaming."><div class="container page-shell"><Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Guías"}]}/><EditorialHero image="guia" eyebrow="Aprende antes de elegir" title="Guías para elegir tecnología gaming" description="Contenido educativo para entender especificaciones y tomar decisiones con contexto." /><section class="content-grid">{guides.map(guide=><article class="info-card surface"><p class="eyebrow">{guide.category}</p><h2>{guide.title}</h2><p>{guide.description}</p><a class="link-arrow" href={`/guias/${guide.slug}`}>Leer guía →</a></article>)}</section></div></BaseLayout>
