---
import BaseLayout from "../layouts/BaseLayout.astro";
import AffiliateBar from "../components/global/AffiliateBar.astro";
import SiteHeader from "../components/global/SiteHeader.astro";
import HeroSection from "../components/home/HeroSection.astro";
import CategoryShortcuts from "../components/home/CategoryShortcuts.astro";
import ProductExplorer from "../components/home/ProductExplorer.astro";
import ComparisonDock from "../components/product/ComparisonDock.astro";
import ToastRegion from "../components/ui/ToastRegion.astro";
import FeaturedGuides from "../components/home/FeaturedGuides.astro";
import TrustSection from "../components/home/TrustSection.astro";
import FaqSection from "../components/home/FaqSection.astro";
import SiteFooter from "../components/global/SiteFooter.astro";
---
<BaseLayout>
  <AffiliateBar />
  <SiteHeader />
  <main id="contenido-principal">
    <HeroSection />
    <CategoryShortcuts />
    <ProductExplorer />
    <FeaturedGuides />
    <TrustSection />
    <FaqSection />
  </main>
  <SiteFooter />
  <ComparisonDock />
  <ToastRegion />
  <script>
    import "../scripts/interactions";
  </script>
</BaseLayout>
