---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroCarousel from "../components/home/HeroCarousel.astro";
import CategoryShortcuts from "../components/home/CategoryShortcuts.astro";
import ProductExplorer from "../components/home/ProductExplorer.astro";
import FeaturedGuides from "../components/home/FeaturedGuides.astro";
import FeaturedComparisons from "../components/home/FeaturedComparisons.astro";
import TrustSection from "../components/home/TrustSection.astro";
import FaqSection from "../components/home/FaqSection.astro";
---
<BaseLayout>
  <div class="home-stagger" data-home-stagger>
    <HeroCarousel />
    <CategoryShortcuts />
    <TrustSection />
    <ProductExplorer />
    <FeaturedComparisons />
    <FeaturedGuides />
    <FaqSection />
  </div>
</BaseLayout>

<style>
  .home-stagger { display:contents; }
</style>
