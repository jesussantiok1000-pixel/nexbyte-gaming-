---
import StaticPage from "../components/content/StaticPage.astro";

const sections = [
  {
    title: "Selecciones para distintos usos",
    text: "Organizamos productos para gaming, estudio, productividad y entretenimiento, facilitando que encuentres opciones acordes con tu espacio y tus prioridades."
  },
  {
    title: "Características que importan",
    text: "Consideramos conectividad, formato, precisión, comodidad, compatibilidad y rendimiento según cada tipo de producto."
  },
  {
    title: "Una colección más fácil de explorar",
    text: "Agrupamos alternativas con beneficios claros para que puedas comparar necesidades, características y formas de uso con rapidez."
  },
  {
    title: "Rendimiento y compatibilidad",
    text: "Destacamos las especificaciones que ayudan a identificar si un equipo encaja con tus dispositivos, actividades y expectativas."
  },
  {
    title: "Información de referencia",
    text: "Consultamos documentación técnica, manuales, estándares y fuentes especializadas para presentar características comprensibles."
  },
  {
    title: "Colecciones que evolucionan",
    text: "Revisamos las categorías y recomendaciones para incorporar nuevas formas de jugar, trabajar, estudiar y mejorar el setup."
  },
  {
    title: "Sugerencias y correcciones",
    text: "Si detectas información que podamos mejorar, puedes compartirla desde nuestra página de contacto."
  }
];
---
<StaticPage
  title="Cómo seleccionamos"
  description="Conoce las características que consideramos para reunir productos y colecciones en NEXBYTE."
  sections={sections}
/>
