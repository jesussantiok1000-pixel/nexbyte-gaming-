---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/product/ProductCard.astro";
import Breadcrumbs from "../components/global/Breadcrumbs.astro";
import EditorialHero from "../components/content/EditorialHero.astro";
import { productRepository } from "../lib/products/LocalProductRepository";
const products = await productRepository.getFeatured(6);
---
<BaseLayout title="Selección NEXBYTE | Tecnología para tu setup" description="Productos destacados para gaming, estudio, productividad y setup.">
  <div class="container page-shell">
    <Breadcrumbs items={[{label:"Inicio",href:"/"},{label:"Selección NEXBYTE"}]} />
    <EditorialHero image="sleccion" eyebrow="PRODUCTOS DESTACADOS" title="Selección NEXBYTE" description="Selecciones pensadas para rendimiento, comodidad y estilo en gaming, estudio y productividad." />
    <p><a class="link-arrow" href="/categorias">Explorar todas las categorías →</a></p>
    <section class="editorial-selections" aria-labelledby="selecciones-editoriales">
      <h2 id="selecciones-editoriales">Colecciones para encontrar tu próxima mejora</h2>
      <div class="content-grid">
        <article class="info-card surface"><p class="eyebrow">GAMING Y CREACIÓN</p><h3>Equipos para jugar, estudiar y crear</h3><p>Combina rendimiento, movilidad y una pantalla adecuada para disfrutar juegos y proyectos.</p><a class="link-arrow" href="/categorias/laptops-gaming">Descubrir opciones →</a></article>
        <article class="info-card surface"><p class="eyebrow">PERIFÉRICOS</p><h3>Control, precisión y comodidad</h3><p>Encuentra teclados, ratones y audio que acompañen tu ritmo dentro y fuera del juego.</p><a class="link-arrow" href="/categorias/teclados-mecanicos">Explorar la colección →</a></article>
        <article class="info-card surface"><p class="eyebrow">SETUP</p><h3>Mejoras para renovar tu espacio</h3><p>Descubre pantallas, ergonomía y accesorios para crear un entorno más cómodo y completo.</p><a class="link-arrow" href="/categorias/setup-gaming">Ver productos destacados →</a></article>
      </div>
    </section>
    <section class="selection-grid">{products.map((product,index)=><ProductCard product={product} index={index}/>)}</section>
  </div>
</BaseLayout>
<style>.editorial-selections{margin:34px 0 42px}.selection-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}@media(max-width:850px){.selection-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.selection-grid{grid-template-columns:1fr}}</style>
